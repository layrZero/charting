{
  "name": "layr0-charts",
  "private": true,
  "homepage": ".",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run signal-receiver\" \"vite\"",
    "forecast:bootstrap": "uv run --project services/kronos python services/kronos/bootstrap.py",
    "forecast:dev": "uv run --project services/kronos python services/kronos/app.py",
    "forecast:test": "uv run --project services/kronos python -m unittest discover -s services/kronos/tests -v",
    "build": "vite build",
    "lint": "eslint src/App.jsx src/components/OpenAlgoTerminal src/services/imcClient.js src/services/imcFeeds.js src/services/workspace.js test",
    "preview": "vite preview",
    "test": "node --test test/**/*.test.mjs",
    "signal-receiver": "node scripts/signal-receiver.js"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.555.0",
    "mqtt": "^5.14.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
