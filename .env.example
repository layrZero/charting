# Non-secret IMC endpoint configuration. Copy to .env.local for development.
# Enter API keys through the browser connection dialog; never commit secrets.
VITE_IMC_API_URL=http://127.0.0.1:8080
VITE_IMC_WS_URL=ws://127.0.0.1:8080/ws
# Local-only TimesFM 3 forecast service. This service never receives IMC credentials.
VITE_FORECAST_URL=http://127.0.0.1:8001
TIMESFM_MODEL_ID=google/timesfm-3.0-pytorch
TIMESFM_SOURCE_REVISION=v3.0.0
TIMESFM_DEVICE=cpu
TIMESFM_MAX_CONTEXT=512
TIMESFM_MAX_HORIZON=10
TIMESFM_ALLOW_NONCOMMERCIAL_WEIGHTS=true
